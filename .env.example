# Vaultly local environment template
# Copy to .env.local and fill in real values for your environment.

# App origin used for redirects and absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_VERIFICATION_KEY=your_privy_verification_public_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Lighthouse Storage
LIGHTHOUSE_API_KEY=your_key_here
# Defaults to lighthouse. Set to mock only for terminal tests.
STORAGE_PROVIDER=lighthouse

# Optional observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
